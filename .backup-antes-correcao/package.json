{
  "name": "speakup",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:smoke": "node --experimental-strip-types --test tests/smoke.mjs",
    "test:integration": "node --env-file=.env tests/integration.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1",
    "lucide-react": "0.468.0",
    "motion": "11.18.2",
    "recharts": "2.15.3",
    "@supabase/supabase-js": "2.49.4",
    "zod": "3.24.4",
    "idb": "8.0.2"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.4.1",
    "vite": "6.3.5",
    "typescript": "5.8.3",
    "tailwindcss": "3.4.17",
    "postcss": "8.5.3",
    "autoprefixer": "10.4.21",
    "eslint": "9.25.1",
    "@eslint/js": "9.25.1",
    "typescript-eslint": "8.31.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "vitest": "3.1.4",
    "@playwright/test": "1.52.0"
  }
}
